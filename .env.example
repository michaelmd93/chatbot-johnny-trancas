# Configurações do Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chatbot_johnny_trancas
DB_USER=seu_usuario_mysql
DB_PASSWORD=sua_senha_mysql

# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Configurações do WhatsApp (futuro)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Configurações da IA (Interpretação de Linguagem Natural)
# Provedor de IA: 'openai', 'anthropic', 'local' (para simulação)
AI_PROVIDER=local
AI_MODEL=gpt-3.5-turbo

# Chaves de API (não colocar valores reais)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Configurações adicionais da IA
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.3
AI_CONFIDENCE_THRESHOLD=0.5
